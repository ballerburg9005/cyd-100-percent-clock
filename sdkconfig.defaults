CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_FREERTOS_HZ=1000
# On clean clones the experimental TF->GPIO25 PAL/NTSC video must be enabled.
# Existing clones need python3 tools/enable_composite_preview.py as well.
CONFIG_CLOCK_COMPOSITE_TF_TEST=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# CONFIG_VIDEO_ENABLE_LVGL_SUPPORT is not set
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# CONFIG_COMPILER_OPTIMIZATION_SIZE is not set
