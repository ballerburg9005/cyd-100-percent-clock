menu "100 Percent Clock board adjustments"
    config CLOCK_LCD_MIRROR_X
        bool "Mirror display horizontally (landscape S022C default)"
        default y
    config CLOCK_LCD_MIRROR_Y
        bool "Mirror display vertically (if needed for your S022C revision)"
        default n
    config CLOCK_TOUCH_SWAP_XY
        bool "Swap X/Y capacitive touch coordinates"
        default n
    config CLOCK_TOUCH_MIRROR_X
        bool "Mirror touch X coordinate"
        default n
    config CLOCK_TOUCH_MIRROR_Y
        bool "Mirror touch Y coordinate"
        default n
endmenu
